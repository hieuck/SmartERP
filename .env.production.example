# Production Environment Configuration
# Copy this file to .env.production and fill in the values

# Application
NODE_ENV=production
PORT=3000
APP_NAME=Smart ERP
APP_URL=https://erp.yourdomain.com

# Database
DB_HOST=your-db-host.com
DB_PORT=5432
DB_USERNAME=erp_user
DB_PASSWORD=your-secure-password-here
DB_DATABASE=smart_erp_production
DB_SSL=true
DB_POOL_SIZE=20

# Redis (for caching and sessions)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# JWT
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-very-long-and-secure-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=7d

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=smart-erp-production

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/smart-erp/app.log

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=https://erp.yourdomain.com,https://www.yourdomain.com

# Monitoring
SENTRY_DSN=your-sentry-dsn-here
NEW_RELIC_LICENSE_KEY=your-newrelic-key

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=smart-erp-backups

# Feature Flags
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AUDIT_LOG=true
ENABLE_RATE_LIMITING=true

# Security
SESSION_SECRET=your-session-secret-key-here
ENCRYPTION_KEY=your-encryption-key-32-chars
BCRYPT_ROUNDS=10

# Payment Gateway (if applicable)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token
