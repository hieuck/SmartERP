# Test Environment Configuration
# This file contains environment variables for test execution

# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=erp_test
TEST_DB_LOGGING=false

# Test Redis Configuration
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=1

# JWT Configuration for Tests
JWT_SECRET=test-secret-key-do-not-use-in-production
JWT_EXPIRATION=1h

# API Configuration
API_BASE_URL=http://localhost:3000
TEST_TIMEOUT=30000

# Test User Credentials
TEST_ADMIN_USERNAME=testadmin
TEST_ADMIN_PASSWORD=Test123!@#
TEST_ADMIN_EMAIL=admin@test.com

TEST_STAFF_USERNAME=teststaff
TEST_STAFF_PASSWORD=Test123!@#
TEST_STAFF_EMAIL=staff@test.com

# Test Tenant IDs
TEST_TENANT_1_ID=test-tenant-001
TEST_TENANT_2_ID=test-tenant-002

# Feature Flags for Tests
ENABLE_TEST_LOGGING=false
ENABLE_TEST_COVERAGE=true
ENABLE_PARALLEL_TESTS=true

# Performance Test Configuration
PERF_TEST_DURATION=60s
PERF_TEST_VUS=100

# E2E Test Configuration
E2E_BASE_URL=http://localhost:5175
E2E_HEADLESS=true
E2E_SLOWMO=0
