{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "backend/**/*.spec.ts",
    "backend/**/*.test.ts",
    "backend/**/*.e2e.spec.ts",
    "backend/**/*.integration.spec.ts",
    "frontend/**/*.spec.ts",
    "frontend/**/*.test.ts",
    "shared/**/*.spec.ts",
    "shared/**/*.test.ts",
    "backend/shared/test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
