# API Configuration
# Monolith backend URL (no microservices, no API Gateway)
VITE_API_URL=http://localhost:3000/api

# WebSocket URL for real-time features
VITE_WS_URL=ws://localhost:3000

# App Configuration
VITE_APP_NAME=SmartERP
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=development

# Monitoring - Sentry (Day 4-7: Add Monitoring)
# Get DSN from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Monitoring - Google Analytics 4 (Day 4-7: Add Monitoring)
# Get Measurement ID from https://analytics.google.com/
VITE_GA4_MEASUREMENT_ID=
