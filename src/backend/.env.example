# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_production

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300
CACHE_MAX=100

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m

# CORS
CORS_ORIGIN=*

# VNPay Payment Gateway
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:3000/payment-gateway/vnpay/return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Momo Payment Gateway
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment-gateway/momo/return
MOMO_IPN_URL=http://localhost:3000/payment-gateway/momo/ipn

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal Payment Gateway
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_RETURN_URL=http://localhost:3000/payment-gateway/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/payment-gateway/paypal/cancel
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# GHN Shipping Provider (Giao Hàng Nhanh)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id

# GHTK Shipping Provider (Giao Hàng Tiết Kiệm)
GHTK_API_URL=https://services.giaohangtietkiem.vn/services
GHTK_TOKEN=your-ghtk-token

# ViettelPost Shipping Provider
VIETTELPOST_API_URL=https://partner.viettelpost.vn/v2
VIETTELPOST_USERNAME=your-viettelpost-username
VIETTELPOST_PASSWORD=your-viettelpost-password

# VNPost Shipping Provider (Vietnam Post)
VNPOST_API_URL=https://donhang.vnpost.vn/api
VNPOST_USERNAME=your-vnpost-username
VNPOST_PASSWORD=your-vnpost-password
VNPOST_CUSTOMER_ID=your-vnpost-customer-id
