#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook - Fast checks only (< 30s)
echo "🔍 Running pre-commit checks..."

# 0. Architecture compliance check (CRITICAL)
echo "🏗️  Checking architecture compliance..."
.husky/architecture-check || {
  echo "❌ Architecture violations found"
  echo "📖 See .kiro/steering/architecture-enforcement.md"
  exit 1
}

# 1. Lint staged files
echo "📝 Linting code..."
npm run lint-staged || {
  echo "❌ Lint failed. Please fix linting errors."
  exit 1
}

# 2. Type check
echo "🔤 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Please fix type errors."
  echo "💡 To skip: git commit --no-verify"
  exit 1
}

# 3. Check for debug code
echo "🐛 Checking for debug code..."
if git diff --cached --name-only | xargs grep -l "console\.log\|debugger" 2>/dev/null; then
  echo "❌ Found console.log or debugger statements"
  echo "💡 Remove them or use proper logging service"
  exit 1
fi

# 4. Check for code smells (warning only)
echo "👃 Checking for code smells..."
if git diff --cached --name-only | xargs grep -l "@ts-ignore\|TODO\|FIXME" 2>/dev/null; then
  echo "⚠️  Found @ts-ignore, TODO, or FIXME"
  echo "💡 Please add ticket reference or explanation"
  # Warning only, don't block
fi

echo "✅ Pre-commit checks passed!"
