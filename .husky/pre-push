#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push hook - Full test suite (< 2min)
echo "🚀 Running pre-push checks..."

# 1. Run ALL unit tests with coverage
echo "🧪 Running all unit tests with coverage..."
npm run test:unit -- --coverage || {
  echo "❌ Unit tests failed. Please fix failing tests."
  echo "💡 To skip: git push --no-verify"
  exit 1
}

# 2. Check coverage thresholds (automatic via jest.config.js)
echo "📊 Coverage thresholds checked automatically"

# 3. Security audit
echo "🔒 Security audit..."
npm run security:audit || {
  echo "⚠️  Security vulnerabilities found. Consider fixing."
  # Don't block - just warn
}

# 4. Validate commit messages (last 5 commits)
echo "📝 Validating commit messages..."
if ! git log --format=%s -5 | grep -qE "^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .+"; then
  echo "⚠️  Some commit messages don't follow conventional commits format"
  echo "💡 Format: <type>(<scope>): <subject>"
  echo "💡 Types: feat, fix, docs, style, refactor, test, chore"
  # Warning only, don't block
fi

echo "✅ Pre-push checks passed!"
