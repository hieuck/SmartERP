{
  "dashboard": {
    "title": "Smart ERP - API Performance",
    "tags": ["smart-erp", "api", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Request Duration (p50, p95, p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(smart_erp_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(smart_erp_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(smart_erp_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
      },
      {
        "id": 2,
        "title": "Requests by Status Code",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(smart_erp_http_requests_total[5m])",
            "legendFormat": "{{status_code}}"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 3,
        "title": "Error Rate by Endpoint",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(smart_erp_http_request_errors_total[5m])",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 4,
        "title": "Slowest Endpoints (avg duration)",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, avg by (method, route) (rate(smart_erp_http_request_duration_seconds_sum[5m]) / rate(smart_erp_http_request_duration_seconds_count[5m])))",
            "format": "table"
          }
        ],
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
      },
      {
        "id": 5,
        "title": "Most Requested Endpoints",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum by (method, route) (rate(smart_erp_http_requests_total[5m])))",
            "format": "table"
          }
        ],
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
