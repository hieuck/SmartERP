# Environment Configuration
NODE_ENV=development

# Database Configuration
POSTGRES_DB=erp_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# SMTP Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# API Gateway
API_GATEWAY_PORT=3000

# Service Ports
AUTH_SERVICE_PORT=3006
PRODUCT_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
CUSTOMER_SERVICE_PORT=3004
SUPPLIER_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3007
REPORT_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
