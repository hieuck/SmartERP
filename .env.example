# Environment Configuration
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_production
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# SMTP Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# Application Port (Monolithic)
PORT=3000

# Frontend URL
FRONTEND_PORT=5173
VITE_PORT=5173

# CORS Configuration
# Comma-separated list of allowed origins (in addition to localhost)
# Example for LAN access: CORS_ORIGIN=http://192.168.2.7:5173
CORS_ORIGIN=http://localhost:5173
