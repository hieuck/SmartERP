# Production Environment Variables
# CRITICAL: Keep this file secure! Never commit actual values to git!

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://erp.yourdomain.com

# Database (use managed database service with SSL)
DB_HOST=<CHANGE_ME_PRODUCTION_DB_HOST>
DB_PORT=5432
DB_USERNAME=<CHANGE_ME_DB_USER>
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_MIN_20_CHARS>
DB_DATABASE=smart_erp_production
DB_POOL_SIZE=50
DB_SSL_CA=<OPTIONAL_SSL_CA_CERTIFICATE>

# Redis (use managed Redis service with password)
REDIS_HOST=<CHANGE_ME_PRODUCTION_REDIS_HOST>
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS_DB=0

# JWT (CRITICAL: Use strong random strings!)
# Generate with: openssl rand -base64 48
JWT_SECRET=<CHANGE_ME_MINIMUM_48_CHARS_RANDOM>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<CHANGE_ME_MINIMUM_48_CHARS_RANDOM>
JWT_REFRESH_EXPIRES_IN=7d

# Session (CRITICAL: Use strong random string!)
SESSION_SECRET=<CHANGE_ME_MINIMUM_48_CHARS_RANDOM>

# Email (use production SMTP service)
SMTP_HOST=<CHANGE_ME_SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=<CHANGE_ME_SMTP_USER>
SMTP_PASSWORD=<CHANGE_ME_SMTP_PASSWORD>
SMTP_FROM=noreply@yourdomain.com

# File Storage (S3 or similar)
AWS_S3_BUCKET=<CHANGE_ME_PRODUCTION_BUCKET>
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<CHANGE_ME_AWS_KEY>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME_AWS_SECRET>

# Logging
LOG_LEVEL=warn

# CORS (CRITICAL: Set specific origins!)
CORS_ORIGIN=https://erp.yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Monitoring (CRITICAL: Enable monitoring!)
SENTRY_DSN=<CHANGE_ME_SENTRY_DSN>

# Features
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AUDIT_LOG=true
ENABLE_METRICS=true

# Payment Gateways (PRODUCTION)
VNPAY_URL=<CHANGE_ME_PRODUCTION_VNPAY_URL>
VNPAY_TMN_CODE=<CHANGE_ME_PRODUCTION_CODE>
VNPAY_HASH_SECRET=<CHANGE_ME_PRODUCTION_SECRET>
VNPAY_RETURN_URL=https://erp.yourdomain.com/payment/vnpay/return

MOMO_PARTNER_CODE=<CHANGE_ME_PRODUCTION_CODE>
MOMO_ACCESS_KEY=<CHANGE_ME_PRODUCTION_KEY>
MOMO_SECRET_KEY=<CHANGE_ME_PRODUCTION_SECRET>
MOMO_ENDPOINT=<CHANGE_ME_PRODUCTION_ENDPOINT>

# Shipping Providers (PRODUCTION)
GHN_API_URL=<CHANGE_ME_PRODUCTION_URL>
GHN_TOKEN=<CHANGE_ME_PRODUCTION_TOKEN>
GHN_SHOP_ID=<CHANGE_ME_PRODUCTION_SHOP_ID>

GHTK_API_URL=<CHANGE_ME_PRODUCTION_URL>
GHTK_TOKEN=<CHANGE_ME_PRODUCTION_TOKEN>

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=<CHANGE_ME_BACKUP_BUCKET>

# Security
ENCRYPTION_KEY=<CHANGE_ME_32_CHARS_RANDOM>
BCRYPT_ROUNDS=12
