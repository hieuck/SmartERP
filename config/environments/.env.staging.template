# Staging Environment Variables
# Copy this file to .env.staging and fill in the values

# Application
NODE_ENV=staging
PORT=3000
APP_URL=https://staging.smarterp.com

# Database (use managed database service)
DB_HOST=staging-db.smarterp.internal
DB_PORT=5432
DB_USERNAME=erp_staging_user
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
DB_DATABASE=smart_erp_staging
DB_POOL_SIZE=20

# Redis (use managed Redis service)
REDIS_HOST=staging-redis.smarterp.internal
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS_DB=0

# JWT (generate strong random strings!)
# Use: openssl rand -base64 48
JWT_SECRET=<CHANGE_ME_MINIMUM_32_CHARS>
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<CHANGE_ME_MINIMUM_32_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_SECRET=<CHANGE_ME_MINIMUM_32_CHARS>

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@smarterp.com
SMTP_PASSWORD=<CHANGE_ME_APP_PASSWORD>
SMTP_FROM=staging@smarterp.com

# File Storage (S3 or similar)
AWS_S3_BUCKET=smarterp-staging
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=https://staging.smarterp.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Monitoring
SENTRY_DSN=<CHANGE_ME_SENTRY_DSN>

# Features
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_AUDIT_LOG=true
ENABLE_METRICS=true

# Payment Gateways (sandbox)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=<CHANGE_ME>
VNPAY_HASH_SECRET=<CHANGE_ME>
VNPAY_RETURN_URL=https://staging.smarterp.com/payment/vnpay/return

MOMO_PARTNER_CODE=<CHANGE_ME>
MOMO_ACCESS_KEY=<CHANGE_ME>
MOMO_SECRET_KEY=<CHANGE_ME>
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Shipping Providers (test)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=<CHANGE_ME>
GHN_SHOP_ID=<CHANGE_ME>

GHTK_API_URL=https://services.giaohangtietkiem.vn/services
GHTK_TOKEN=<CHANGE_ME>
