# Development Environment Variables
# Copy this file to .env in project root for local development

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=smart_erp_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT (use strong random strings in production!)
JWT_SECRET=dev-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Session
SESSION_SECRET=dev-session-secret-change-in-production

# Email (use Mailtrap for dev testing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=dev@smarterp.local

# File Storage (local for dev)
STORAGE_PATH=./uploads

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=*

# Payment Gateways (sandbox/test)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Shipping Providers (test)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=

GHTK_API_URL=https://services.giaohangtietkiem.vn/services
GHTK_TOKEN=
