# Dockerfile for running tests
# Optimized for unit, integration, and E2E tests

# Base stage with common dependencies
FROM node:22.12-alpine3.20 AS base
WORKDIR /app

# Install common test dependencies
RUN apk add --no-cache curl

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for testing)
RUN npm ci

# Copy source code
COPY . .

# Stage for unit and integration tests (no browser needed)
FROM base AS test-unit
WORKDIR /app

# Default command for unit tests
CMD ["npm", "test"]

# Stage for E2E tests (with Playwright)
FROM base AS test-e2e
WORKDIR /app

# Install Playwright dependencies
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto-emoji

# Set Playwright to use installed Chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Install Playwright
RUN npx playwright install-deps || true

# Default command for E2E tests
CMD ["npm", "run", "test:e2e"]
