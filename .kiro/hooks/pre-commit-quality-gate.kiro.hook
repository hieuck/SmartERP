{
  "enabled": true,
  "name": "Pre-Commit Quality Gate",
  "description": "Enhanced quality gate with lint, type-check, tests, and security audit",
  "version": "2",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "cd src/backend && npm run lint && npm run type-check && npm run test:changed && npm run security:audit"
  }
}
