{
  "enabled": true,
  "name": "Auto Work - Execute Immediately",
  "description": "Khi user gửi yêu cầu, tự động phân tích và execute ngay. Không hỏi, không confirm.",
  "version": "1.0",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "⚡ AUTONOMOUS MODE\n\nAnalyze request → Execute immediately → Actions only, minimal text\n\n**RULES:**\n- Read files → Make changes → Run tests → Done\n- NO explanations, NO questions, NO confirmations\n- Report: 1 sentence max\n\n**EXECUTE NOW!**"
  }
}
