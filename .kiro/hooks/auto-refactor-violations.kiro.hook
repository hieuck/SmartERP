{
  "name": "Auto-Refactor Violations",
  "version": "1.0.0",
  "description": "Automatically detect and refactor architecture violations in codebase",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Follow autonomous-development-workflow.md Mode 3 (Refactoring). Scan modified files for violations, check exception list, refactor non-legacy code, verify and auto-commit."
  }
}
