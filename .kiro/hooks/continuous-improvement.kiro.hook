{
  "name": "Continuous Improvement",
  "version": "1.0.0",
  "description": "Continuously improve codebase - scan for issues, suggest improvements, auto-fix when possible",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Follow autonomous-development-workflow.md Mode 4 (Continuous Improvement). Run codebase health check, prioritize issues, auto-fix critical/high, report medium/low with metrics."
  }
}
