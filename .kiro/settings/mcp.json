{
  "mcpServers": {
    // ========================================
    // SmartERP Development MCP Servers
    // ========================================
    // 1. Git Operations (High Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": [
        "read_file",
        "list_directory"
      ]
    },
    // 2. PostgreSQL Database (High Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "postgres": {
      "command": "uvx",
      "args": [
        "mcp-server-postgres"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://postgres:postgres@localhost:5432/smarterp_dev"
      },
      "disabled": true,
      "autoApprove": [
        "query"
      ]
    },
    // 3. Filesystem Operations (High Priority)
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./src"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "read_file",
        "list_directory",
        "create_directory",
        "create_directory"
      ]
    },
    // 4. Web Fetch for Research (Medium Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": [
        "fetch"
      ]
    },
    // 5. GitHub Integration (Medium Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "github": {
      "command": "uvx",
      "args": [
        "mcp-server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your-github-token-here"
      },
      "disabled": true,
      "autoApprove": [
        "search_repositories",
        "get_file_contents"
      ]
    },
    // 6. Docker Operations (Low Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "docker": {
      "command": "uvx",
      "args": [
        "mcp-server-docker"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": []
    },
    // 7. Slack Notifications (Low Priority)
    // DISABLED: Requires 'uv' installation (https://docs.astral.sh/uv/getting-started/installation/)
    // To enable: Install uv with: irm https://astral.sh/uv/install.ps1 | iex
    "slack": {
      "command": "uvx",
      "args": [
        "mcp-server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "your-slack-token-here",
        "SLACK_TEAM_ID": "your-team-id"
      },
      "disabled": true,
      "autoApprove": []
    },
    // 8. Playwright Browser Automation (High Priority)
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "playwright_navigate",
        "playwright_screenshot",
        "playwright_click",
        "playwright_fill",
        "playwright_select",
        "playwright_hover",
        "playwright_evaluate"
      ]
    }
  }
}